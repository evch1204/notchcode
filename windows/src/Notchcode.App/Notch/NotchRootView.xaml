<!--
  NotchRootView.xaml
  Port of Sources/notchcode/Notch/NotchRootView.swift: the one black shape that morphs, and
  what sits around and inside it. Back to front: the hover rim (glow and crescent), the clay
  bleed, the shape itself (with the card and attention shadow), the content clipped to the
  shape. Sizes, positions and the clip are set per frame from the code-behind.
-->
<UserControl x:Class="Notchcode.Notch.NotchRootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:notch="clr-namespace:Notchcode.Notch"
             Focusable="False">
    <Canvas x:Name="Root" ClipToBounds="False">
        <Canvas x:Name="RimLayer" IsHitTestVisible="False" Opacity="0">
            <Path x:Name="RimGlow" />
            <Path x:Name="RimCrescent" />
        </Canvas>
        <Ellipse x:Name="Bleed" IsHitTestVisible="False" Opacity="0" />
        <notch:NotchShapeElement x:Name="Shape" />
        <Canvas x:Name="ContentHost" />
    </Canvas>
</UserControl>
