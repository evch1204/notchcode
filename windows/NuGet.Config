<?xml version="1.0" encoding="utf-8"?>
<!-- The per-user NuGet config on this PC lists no package source; the test project needs xunit
     and the hook's self-contained publish needs the runtime packs, both from nuget.org. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
